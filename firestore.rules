rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Red de Seguridad Global por Defecto
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Funciones Primitivas de Validación y Seguridad
    function isValidId(id) {
      return id is string 
        && id.size() > 0 
        && id.size() <= 128 
        && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 3. Validación Estricta de Entidad de Jornada Semanal (WeekData)
    function isValidWeek(data) {
      return data.id is string 
        && data.id.size() <= 64 
        && data.routes is list 
        && data.routes.size() <= 40
        && data.updatedAt is string
        && data.updatedAt.size() <= 40;
    }

    // 4. Validación Estricta de Configuraciones del Sistema (AppConfigData)
    function isValidSetting(data) {
      return (data.config is map || data.goals is map || data.logs is list)
        && data.updatedAt is string
        && data.updatedAt.size() <= 40;
    }

    // 5. Rutas y Colecciones Operativas de FV MEGAMAYORISTA
    match /test/connection {
      allow read: if true;
      allow write: if false;
    }

    match /weeks/{weekId} {
      allow get, list: if true;
      allow create, update: if isValidId(weekId) && isValidWeek(incoming());
      allow delete: if false;
    }

    match /settings/{settingId} {
      allow get, list: if true;
      allow create, update: if isValidId(settingId) && isValidSetting(incoming());
      allow delete: if false;
    }
  }
}
